# Backend configuration. Copy to .env (setup.bat / setup.sh does this and generates tokens).
# .env is git-ignored. Never commit real tokens.

# Network binding. 0.0.0.0 = reachable from the ESP32 on the same Wi-Fi / hotspot.
LANDSLIDE_HOST=0.0.0.0
LANDSLIDE_PORT=8000

# Device authentication: comma-separated device_id:token pairs (tokens >= 16 characters).
# The ESP32's DEVICE_TOKEN in firmware/landslide_monitor/secrets.h must match its entry.
LANDSLIDE_DEVICE_TOKENS=

# Admin token for dataset annotation and model reload from the dashboard (>= 16 characters).
LANDSLIDE_ADMIN_TOKEN=

# Demonstration mode: allow a model trained on SYNTHETIC data to produce predictions.
# Keep false for real experiments. `start.bat demo` / `./start.sh demo` enables it for one run.
LANDSLIDE_DEMO_MODE=false

# Seconds without telemetry before a device is shown offline, and the age after which
# a prediction is shown as stale on the dashboard.
LANDSLIDE_DEVICE_OFFLINE_S=10
LANDSLIDE_PREDICTION_FRESH_S=10

# Optional paths (defaults shown, relative to the repository root)
# LANDSLIDE_DB=backend/data/landslide.db
# LANDSLIDE_BACKUP_DIR=backend/data/backups
# LANDSLIDE_LOG_DIR=logs
# LANDSLIDE_ARTIFACTS_DIR=ml/artifacts

# Cross-origin access is disabled by default (the dashboard is served by the backend).
# LANDSLIDE_CORS_ORIGINS=http://localhost:5173
# LANDSLIDE_MAX_BODY_BYTES=65536
